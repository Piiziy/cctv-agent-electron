{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SCENE_STEALER_API_URL", "SCENE_STEALER_SUPABASE_URL", "SCENE_STEALER_SUPABASE_ANON_KEY"],
      "outputs": ["out/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test:unit": {},
    "test:e2e": {
      "cache": false
    },
    "test": {
      "cache": false
    }
  }
}
