{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "preview-ios": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": { "simulator": false },
      "channel": "preview"
    },
    "simulator-ios": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": { "simulator": true },
      "channel": "preview"
    },
    "preview-android": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": { "production": {} }
}
